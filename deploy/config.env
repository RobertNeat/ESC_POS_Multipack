# ZOD image registry properties
IMAGE_TITLE="ESC_POS_Multipack"
IMAGE_DESCRIPTION="Bisoffice POS-8370 thermal printer software"
IMAGE_VENDOR="RobertNeat"
IMAGE_LICENSES="MIT"
IMAGE_SOURCE="https://github.com/RobertNeat/ESC_POS_Multipack"

# Production ports exposed on docker-production (192.168.1.160).
CLIENT_PORT=10100
SERVICE_PORT=10120

# Runtime configuration for the production host.
PUBLIC_HOST=192.168.1.160
PRINTER_TRANSPORT=lan
PRINTER_HOST=192.168.1.100
PRINTER_PORT=9100
PRINTER_TIMEOUT_MS=5000