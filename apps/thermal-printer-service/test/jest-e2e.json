{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.ts$": [
      "ts-jest",
      {
        "tsconfig": {
          "module": "CommonJS",
          "moduleResolution": "Node",
          "resolvePackageJsonExports": false
        }
      }
    ]
  },
  "moduleNameMapper": {
    "^@esc-pos-multipack/printer-adapter$": "<rootDir>/../../../packages/printer-adapter/src/index.ts",
    "^@esc-pos-multipack/pos-8370-adapter$": "<rootDir>/../../../packages/pos-8370-adapter/src/index.ts",
    "^@esc-pos-multipack/pos-8370-adapter/low-level$": "<rootDir>/../../../packages/pos-8370-adapter/src/low-level.ts",
    "^(\\.{1,2}/.*)\\.js$": "$1"
  }
}
