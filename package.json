{
  "name": "esc-pos-multipack",
  "version": "1.0.0",
  "description": "BisOffice POS-8370 thermal printer document management suite",
  "author": "RobertNeat",
  "keywords": [
    "POS-8370",
    "BisOffice",
    "thermal printer",
    "ESC",
    "POS"
  ],
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev:thermal-printer": "node scripts/dev-thermal-printer.mjs both",
    "dev:thermal-printer-service": "node scripts/dev-thermal-printer.mjs service",
    "dev:thermal-printer-simple-client": "node scripts/dev-thermal-printer.mjs client",
    "docker:thermal-printer": "docker compose up --build",
    "docker:thermal-printer:down": "docker compose down",
    "build": "pnpm -r build",
    "lint": "eslint . && pnpm --filter thermal-printer-simple-client lint",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"*.{json,mjs,yml}\" \"scripts/**/*.{mjs,cjs}\" \"apps/**/*.{ts,html,css,json,mjs,cjs}\" \"packages/**/*.{ts,json,mjs}\"",
    "format:check": "prettier --check \"*.{json,mjs,yml}\" \"scripts/**/*.{mjs,cjs}\" \"apps/**/*.{ts,html,css,json,mjs,cjs}\" \"packages/**/*.{ts,json,mjs}\"",
    "test": "pnpm -r test",
    "clean": "pnpm -r clean"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "prettier": "^3.8.1",
    "typescript-eslint": "^8.20.0",
    "typescript": "^5.9.0"
  }
}
