{
  "name": "esc-pos-multipack",
  "version": "1.0.0",
  "description": "BisOffice POS-8370 thermal printer document management suite",
  "author": "RobertNeat",
  "keywords": [
    "POS-8370",
    "BisOffice",
    "thermal printer",
    "ESC",
    "POS"
  ],
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev:thermal-printer": "pnpm --parallel --filter thermal-printer-service --filter thermal-printer-simple-client run dev",
    "dev:thermal-printer-service": "pnpm --filter thermal-printer-service dev",
    "dev:thermal-printer-simple-client": "pnpm --filter thermal-printer-simple-client dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "clean": "pnpm -r clean"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  }
}
