{
  "name": "@esc-pos-multipack/pos-8370-adapter",
  "version": "0.1.0",
  "description": "BisOffice POS-8370 implementation of the printer adapter contracts.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "settings.schema.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@esc-pos-multipack/printer-adapter": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "@node-escpos/core": "*"
  },
  "peerDependenciesMeta": {
    "@node-escpos/core": {
      "optional": true
    }
  }
}
